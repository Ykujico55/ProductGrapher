  "items": [
    {
      "nodeId": "entry:dispatchdesk/__main__.py:function:dispatchdesk/__main__.py:main:21:stock",
      "capability": "接单与库存预留",
      "title": "仓库补货",
      "aliases": [
        "补货",
        "库存入库",
        "补货后重试"
      ],
      "text": "给指定仓库的某个 SKU 增加可用数量，随后按接单顺序重新尝试为等待订单分配库存。",
