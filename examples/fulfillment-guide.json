      ]
    },
    {
      "nodeId": "entry:dispatchdesk/__main__.py:function:dispatchdesk/__main__.py:main:33:cancel",
      "capability": "接单与库存预留",
      "title": "取消未发货订单",
      "aliases": [
        "取消订单",
        "撤单",
        "取消预留",
        "部分发货后取消"
      ],
      "text": "只有等待库存（waiting）或已预留（reserved）的订单可以取消。已预留的商品按原仓和 SKU 补回可用库存，分配记录被删除，再重试等待订单；即使只发出了一个仓，也不能取消。",
